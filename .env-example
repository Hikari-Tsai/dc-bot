# Discord bot token。
# 請到 Discord Developer Portal 取得。真實 token 只放在 .env。
DISCORD_TOKEN=your_discord_bot_token_here

# OpenAI API key。
# 真實 API key 只放在 .env，請勿提交到 git。
OPENAI_API_KEY=sk-your_openai_api_key_here

# Bot 可以回應的 Discord 頻道 ID。
# 若程式允許，設定為 0 代表不限制頻道。
TARGET_CHANNEL_ID=0

# 每位一般使用者要帶入的最近已回答對話數量。
USER_CONTEXT_LIMIT=5

# 每筆歷史問題與回答最多保留的字元數。
CONTEXT_QUESTION_LIMIT=500
CONTEXT_ANSWER_LIMIT=800

# 被辨識為台主的 Discord 使用者 ID。
# 多個 ID 可以用逗號分隔。
OWNER_USER_IDS=123456789012345678

# 沒有設定 Discord user ID 或 ID 比對失敗時，可用名稱推測台主。
# 多個名稱可以用逗號分隔；名稱可被冒用，因此只適合作為備援。
OWNER_USER_NAMES=台主名稱,owner_display_name

# 台主可以使用不同的上下文保留數量。
OWNER_CONTEXT_LIMIT=10

# 只有發問者是台主時，才會額外加入的提示詞。
OWNER_PROMPT_HINT=目前發問者是台主。你可以用更熟悉、自然的語氣回應，但仍保持尊重與清楚。
