# Discord bot token。
# 請到 Discord Developer Portal 取得。真實 token 只放在 .env。
DISCORD_TOKEN=your_discord_bot_token_here

# OpenAI API key。
# 真實 API key 只放在 .env，請勿提交到 git。
OPENAI_API_KEY=sk-your_openai_api_key_here

# OpenAI 回覆模型。
# 可選模型：
# gpt-5.6-sol   - 適合複雜推理，品質最高、成本也最高
# gpt-5.6-terra - 智慧、速度與成本較平衡
# gpt-5.6-luna  - 適合低成本、高流量的聊天用途
# gpt-5.5       - 適合複雜的專業工作
# gpt-5.4       - 較實惠的專業工作模型
# gpt-5.4-mini  - 較低延遲、較低成本的 5.4 模型
# gpt-5.4-nano  - 適合簡單、高流量工作的低成本模型
# gpt-5.3-chat-latest - 已淘汰，不建議新專案使用
# gpt-5.2       - 原本使用的模型，保留供相容使用
OPENAI_MODEL=gpt-5.4-mini

# Bot 可以回應的 Discord 頻道 ID。
# 若程式允許，設定為 0 代表不限制頻道。
TARGET_CHANNEL_ID=0

# 每位一般使用者要帶入的最近已回答對話數量。
USER_CONTEXT_LIMIT=5

# 每筆歷史問題與回答最多保留的字元數。
CONTEXT_QUESTION_LIMIT=500
CONTEXT_ANSWER_LIMIT=800

# 被辨識為台主的 Discord 使用者 ID。
# 多個 ID 可以用逗號分隔。
OWNER_USER_IDS=123456789012345678

# 沒有設定 Discord user ID 或 ID 比對失敗時，可用名稱推測台主。
# 多個名稱可以用逗號分隔；名稱可被冒用，因此只適合作為備援。
OWNER_USER_NAMES=台主名稱,owner_display_name

# 台主可以使用不同的上下文保留數量。
OWNER_CONTEXT_LIMIT=10

# 只有發問者是台主時，才會額外加入的提示詞。
OWNER_PROMPT_HINT=目前發問者是台主。你可以用更熟悉、自然的語氣回應，但仍保持尊重與清楚。
